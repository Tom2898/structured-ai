{
  "functions": {
    "api/*.js": {
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/api/send-upgrade-emails",
      "schedule": "0 9 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; object-src 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "(.*)",
      "destination": "/index.html"
    }
  ]
}